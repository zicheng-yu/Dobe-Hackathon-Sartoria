  "cases": [
    {"id":"01a","text":"朋友圈那件紫色的照片我发你，是想借它的肩线。颜色我想要灰色。","hard":["灰色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["紫色"]},
    {"id":"01b","text":"颜色我想要灰色。朋友圈那件紫色的照片我也发你，是想借它的肩线。","hard":["灰色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["紫色"]},
    {"id":"02a","text":"照片上那件酒红色的你看看，腰收得挺舒服，我这回只想要那个腰型。颜色上我比较喜欢米色。","hard":[],"excluded":[],"preferred":["米色"],"pending":[],"referenceOnly":["酒红色"]},
    {"id":"02b","text":"颜色上我比较喜欢米色。照片上那件酒红色的你也看看，我这回只想要那个腰型。","hard":[],"excluded":[],"preferred":["米色"],"pending":[],"referenceOnly":["酒红色"]},
    {"id":"03a","text":"我发的照片里是件蓝色西装，跟它取个袖长就好。颜色我们到店再聊。","hard":[],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["蓝色"]},
    {"id":"03b","text":"颜色就用我发的那张照片里那种蓝色。袖长我们到店再聊。","hard":["蓝色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"04a","text":"网上那件红色外套，借一下它的扣位。黑色我这次不做。","hard":[],"excluded":["黑色"],"preferred":[],"pending":[],"referenceOnly":["红色"]},
    {"id":"04b","text":"网上那件红色外套，扣位借一下，面料也就定红色。黑色我这次不做。","hard":["红色"],"excluded":["黑色"],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"05a","text":"我妈拿来一张照片，说‘这个黄色多精神’。我是让你看图里那个短一点的下摆，颜色我暂时没想。","hard":[],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["黄色"]},
    {"id":"05b","text":"我妈拿来一张照片，说‘这个黄色多精神’。我也想用这个黄色，下摆我们店里再量。","hard":["黄色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"06a","text":"如果公司最后同意灰色，我就用灰色。行政还没回话。","hard":[],"excluded":[],"preferred":[],"pending":["灰色"],"referenceOnly":[]},
    {"id":"06b","text":"如果公司最后同意灰色，我就用灰色。行政刚回话了，同意了，给我定灰色吧。","hard":["灰色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"07a","text":"活动主题还没出来。假如主办方让大家穿绿色，那我这件就做绿色。","hard":[],"excluded":[],"preferred":[],"pending":["绿色"],"referenceOnly":[]},
    {"id":"07b","text":"假如主办方让大家穿绿色，那我这件就做绿色。活动主题还没出来。","hard":[],"excluded":[],"preferred":[],"pending":["绿色"],"referenceOnly":[]},
    {"id":"08a","text":"我平常更中意藏青色。如果同事也定了白色制服，我再考虑白色，她还没定。","hard":[],"excluded":[],"preferred":["藏青色"],"pending":["白色"],"referenceOnly":[]},
    {"id":"08b","text":"如果同事也定了白色制服，我再考虑白色，她还没定。我平常更中意藏青色，这件也优先看藏青色。","hard":[],"excluded":[],"preferred":["藏青色"],"pending":["白色"],"referenceOnly":[]},
    {"id":"09a","text":"图里那套粉色的只看领子。要是新娘确定让我穿咖啡色，我再做咖啡色，等她通知。","hard":[],"excluded":[],"preferred":[],"pending":["咖啡色"],"referenceOnly":["粉色"]},
    {"id":"09b","text":"要是新娘确定让我穿咖啡色，我再做咖啡色，等她通知。图里那套粉色的只看领子。","hard":[],"excluded":[],"preferred":[],"pending":["咖啡色"],"referenceOnly":["粉色"]},
    {"id":"10a","text":"摄影师提过‘白色在这个场地可能过曝’，他还在试灯。我先定蓝色面料。","hard":["蓝色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["白色"]},
    {"id":"10b","text":"摄影师还在试灯，说白色可能过曝。我已经想好了，这件就做蓝色，白色明确排掉。","hard":["蓝色"],"excluded":["白色"],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"11a","text":"黑色不要。米色我只有看过实物、确认合适才会订，现在还没看过。","hard":[],"excluded":["黑色"],"preferred":[],"pending":["米色"],"referenceOnly":[]},
    {"id":"11b","text":"米色我只有看过实物、确认合适才会订，现在还没看过。还有黑色不要，先划掉。","hard":[],"excluded":["黑色"],"preferred":[],"pending":["米色"],"referenceOnly":[]},
    {"id":"12a","text":"你问我是不是定红色？没有。弟弟的照片是红色，但我找你是因为喜欢图里那个长度。","hard":[],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["红色"]},
    {"id":"12b","text":"你问我是不是定红色？对，就红色。弟弟的照片是同色的，我也喜欢图里那个长度。","hard":["红色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"13a","text":"我先要米色。照片上那件深棕色你看看它是不是羊毛，我问的是料子。","hard":["米色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["深棕色"]},
    {"id":"13b","text":"照片上那件深棕色你看看它是不是羊毛，我问的是料子。颜色这次我先要米色。","hard":["米色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["深棕色"]},
    {"id":"14a","text":"我拿图里那条蓝色裤子当例子，是想说口袋的位置。面料颜色的话我更喜欢棕色。橙色就别拿了。","hard":[],"excluded":["橙色"],"preferred":["棕色"],"pending":[],"referenceOnly":["蓝色"]},
    {"id":"14b","text":"我拿图里那条蓝色裤子当例子，口袋看它，颜色也定蓝色。橙色就别拿了。","hard":["蓝色"],"excluded":["橙色"],"preferred":[],"pending":[],"referenceOnly":[]},
    {"id":"15a","text":"我姐留言说‘要不就酒红色？’这单是我的，她说的我先没接。给你图片主要是让你看下前襟。","hard":[],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["酒红色"]},
    {"id":"15b","text":"我姐留言说‘要不就酒红色？’这单是我的，我也更喜欢酒红色，先让我看看这色的料。","hard":[],"excluded":[],"preferred":["酒红色"],"pending":[],"referenceOnly":[]},
    {"id":"16a","text":"先别替我选。要是爷爷答应穿紫色我才订紫色，他还在想。样衣照片里的棕色是顺手拍到的，我是让你看门襟。","hard":[],"excluded":[],"preferred":[],"pending":["紫色"],"referenceOnly":["棕色"]},
    {"id":"16b","text":"样衣照片里的棕色是顺手拍到的，我是让你看门襟。爷爷现在答应了，就给他订紫色。","hard":["紫色"],"excluded":[],"preferred":[],"pending":[],"referenceOnly":["棕色"]}
